#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
while IFS= read -r -d '' file; do php -l "$file" >/dev/null; done < <(find "$ROOT" -type f -name '*.php' -print0)
php "$ROOT/tests/source-conformance.php"
php "$ROOT/tests/work-provider-smoke.php"
php "$ROOT/tests/business-identifiers-smoke.php"
php "$ROOT/tests/security-boundary-smoke.php"
php "$ROOT/tests/localization-conformance.php"
php "$ROOT/tests/panels-decomposition-smoke.php"
php "$ROOT/tests/docs-decomposition-smoke.php"
echo "Core Blueprint CRM checks passed."
