#!/usr/bin/env bash
set -euo pipefail

# Real WordPress/MariaDB integration, isolated per run. No database DROP.
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
BASE_SOURCE="$(printenv CB_CRM_TEST_BASE_SOURCE || printf '%s' "$HOME/Downloads/wp-core-blueprint")"
WP_VERSION="$(printenv CB_CRM_TEST_WP_VERSION || printf '7.0')"
CONTAINER="cb-base-test-db"
PARENT="/tmp/core-blueprint-tests/core-blueprint-crm-sales"
umask 077

fail() { printf 'CRM Sales integration FAIL: %s\n' "$*" >&2; exit 1; }
[[ "$WP_VERSION" == "7.0" || "$WP_VERSION" == "7.1" ]] || fail 'Unsupported WordPress version'
for command in php wp docker git tar mktemp cut tr; do
  command -v "$command" >/dev/null || fail "Missing command: $command"
done
php -r 'exit(version_compare(PHP_VERSION,"8.4",">=") && extension_loaded("mysqli") && extension_loaded("mbstring") ? 0 : 1);' \
  || fail 'Requires PHP 8.4+, mysqli and mbstring.'
[[ -f "$BASE_SOURCE/core-blueprint.php" ]] || fail "Missing local Base checkout: $BASE_SOURCE"
[[ -f "$ROOT/core-blueprint-crm.php" ]] || fail 'CRM source checkout missing'
[[ -f "$ROOT/tests/integration/sales-mariadb.php" ]] || fail 'Integration PHP fixture missing'

image="$(docker inspect --format '{{.Config.Image}}' "$CONTAINER" 2>/dev/null)" \
  || fail "Missing canonical MariaDB container: $CONTAINER"
[[ "$image" == "mariadb:10.11.19" ]] || fail "Unexpected MariaDB image: $image"
[[ "$(docker inspect --format '{{.State.Running}}' "$CONTAINER")" == "true" ]] \
  || fail 'MariaDB container is not running'
[[ "$(docker port "$CONTAINER" 3306/tcp)" == "127.0.0.1:3307" ]] \
  || fail 'MariaDB must only be bound to 127.0.0.1:3307'

# Prefer explicit override; otherwise read the bootstrap credential in the
# already-running local container without printing it to terminal/logs.
db_root_password="$(printenv CB_CRM_TEST_DB_ROOT_PASSWORD || true)"
if [[ -z "$db_root_password" ]]; then
  while IFS= read -r entry; do
    case "$entry" in
      MARIADB_ROOT_PASSWORD=*)
        db_root_password="$(printf '%s' "$entry" | cut -d= -f2-)" ;;
      MYSQL_ROOT_PASSWORD=*)
        if [[ -z "$db_root_password" ]]; then
          db_root_password="$(printf '%s' "$entry" | cut -d= -f2-)"
        fi ;;
    esac
  done < <(docker inspect --format '{{range .Config.Env}}{{println .}}{{end}}' "$CONTAINER")
fi
[[ -n "$db_root_password" ]] || fail 'Set CB_CRM_TEST_DB_ROOT_PASSWORD locally'
db_root() {
  docker exec -i -e "MYSQL_PWD=$db_root_password" "$CONTAINER" \
    mariadb --protocol=socket -uroot --batch --skip-column-names "$@"
}
db_root --execute='SELECT 1' >/dev/null || fail 'Local root authentication failed'

mkdir -p "$PARENT"
run_root="$(mktemp -d "$PARENT/run.XXXXXXXX")"
suffix="$(basename "$run_root" | cut -d. -f2 | tr '[:upper:]' '[:lower:]')"
[[ "$suffix" =~ ^[a-z0-9]{8}$ ]] || fail 'Unexpected isolated folder suffix'
database="cb_crm_it_$suffix"
db_user="cb_it_$suffix"
db_password="$(php -r 'echo bin2hex(random_bytes(24));')"
wp_root="$run_root/wordpress"
crm_sha="$(git -C "$ROOT" rev-parse HEAD)"
base_sha="$(git -C "$BASE_SOURCE" rev-parse HEAD)"
mkdir -p "$wp_root/wp-content/plugins/core-blueprint" "$wp_root/wp-content/plugins/core-blueprint-crm"

echo "ISOLATED_ROOT=$run_root"
echo "ISOLATED_DB=$database"
echo "CRM_SHA=$crm_sha"
echo "BASE_SHA=$base_sha"
echo 'Existing databases, installations, local repositories and dist/ are never overwritten.'

# Names are random, validated and non-reused. No DROP DATABASE/USER is used.
db_root --execute="
CREATE DATABASE $database CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
CREATE USER '$db_user'@'%' IDENTIFIED BY '$db_password';
GRANT ALL PRIVILEGES ON $database.* TO '$db_user'@'%';
" || fail 'Could not create isolated database and restricted test user'

git -C "$BASE_SOURCE" archive --format=tar "$base_sha" \
  | tar -xf - -C "$wp_root/wp-content/plugins/core-blueprint"
git -C "$ROOT" archive --format=tar "$crm_sha" \
  | tar -xf - -C "$wp_root/wp-content/plugins/core-blueprint-crm"

wp core download --path="$wp_root" --version="$WP_VERSION" --locale=en_US --skip-content --quiet
[[ "$(wp core version --path="$wp_root")" == "$WP_VERSION" ]] || fail 'Wrong WordPress version'
wp config create --path="$wp_root" --dbname="$database" --dbuser="$db_user" \
  --dbpass="$db_password" --dbhost="127.0.0.1:3307" --dbprefix="cbt_" --skip-check --quiet
wp config set DISABLE_WP_CRON true --raw --path="$wp_root" --quiet
wp config set CB_CRM_INTEGRATION_DISPOSABLE true --raw --path="$wp_root" --quiet

admin_password="$(php -r 'echo bin2hex(random_bytes(24));')"
wp core install --path="$wp_root" --url="http://crm-sales-test.invalid" \
  --title="CRM Sales Integration Test" --admin_user="crm-it-admin" \
  --admin_password="$admin_password" --admin_email="crm-test@example.invalid" \
  --skip-email --quiet

wp plugin activate core-blueprint --path="$wp_root" --quiet
wp plugin activate core-blueprint-crm --path="$wp_root" --quiet

echo '==> Running actual WordPress and InnoDB tests'
wp eval-file "$ROOT/tests/integration/sales-mariadb.php" --path="$wp_root"
echo 'CRM Sales real WordPress/MariaDB integration: PASS'
echo "Artifacts and isolated database retained for inspection: $run_root | $database"
