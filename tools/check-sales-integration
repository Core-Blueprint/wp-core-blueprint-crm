#!/usr/bin/env bash
set -euo pipefail

# Real WordPress/MariaDB integration, isolated per run. No database DROP.
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
BASE_SOURCE="$(printenv CB_CRM_TEST_BASE_SOURCE || printf '%s' "$HOME/Downloads/wp-core-blueprint")"
WP_VERSION="$(printenv CB_CRM_TEST_WP_VERSION || printf '7.0')"
CONTAINER="cb-base-test-db"
PARENT="/tmp/core-blueprint-tests/core-blueprint-crm-sales"
umask 077

fail() { printf 'CRM Sales integration FAIL: %s\n' "$*" >&2; exit 1; }
[[ "$WP_VERSION" == "7.0" || "$WP_VERSION" == "7.1" ]] || fail 'Unsupported WordPress version'
for command in php wp docker git tar mktemp cut tr timeout; do
  command -v "$command" >/dev/null || fail "Missing command: $command"
done
php -r 'exit(version_compare(PHP_VERSION,"8.4",">=") && extension_loaded("mysqli") && extension_loaded("mbstring") ? 0 : 1);' \
  || fail 'Requires PHP 8.4+, mysqli and mbstring.'
[[ -f "$BASE_SOURCE/core-blueprint.php" ]] || fail "Missing local Base checkout: $BASE_SOURCE"
[[ -f "$ROOT/core-blueprint-crm.php" ]] || fail 'CRM source checkout missing'
[[ -f "$ROOT/tests/integration/sales-mariadb.php" ]] || fail 'Integration PHP fixture missing'

image="$(docker inspect --format '{{.Config.Image}}' "$CONTAINER" 2>/dev/null)" \
  || fail "Missing canonical MariaDB container: $CONTAINER"
[[ "$image" == "mariadb:10.11.19" ]] || fail "Unexpected MariaDB image: $image"
[[ "$(docker inspect --format '{{.State.Running}}' "$CONTAINER")" == "true" ]] \
  || fail 'MariaDB container is not running'
[[ "$(docker port "$CONTAINER" 3306/tcp)" == "127.0.0.1:3307" ]] \
  || fail 'MariaDB must only be bound to 127.0.0.1:3307'

# Prefer explicit override; otherwise read the bootstrap credential in the
# already-running local container without printing it to terminal/logs.
db_root_password="$(printenv CB_CRM_TEST_DB_ROOT_PASSWORD || true)"
if [[ -z "$db_root_password" ]]; then
  while IFS= read -r entry; do
    case "$entry" in
      MARIADB_ROOT_PASSWORD=*)
        db_root_password="$(printf '%s' "$entry" | cut -d= -f2-)" ;;
      MYSQL_ROOT_PASSWORD=*)
        if [[ -z "$db_root_password" ]]; then
          db_root_password="$(printf '%s' "$entry" | cut -d= -f2-)"
        fi ;;
    esac
  done < <(docker inspect --format '{{range .Config.Env}}{{println .}}{{end}}' "$CONTAINER")
fi
[[ -n "$db_root_password" ]] || fail 'Set CB_CRM_TEST_DB_ROOT_PASSWORD locally'
db_root() {
  docker exec -i -e "MYSQL_PWD=$db_root_password" "$CONTAINER" \
    mariadb --protocol=socket -uroot --batch --skip-column-names "$@"
}
db_root --execute='SELECT 1' >/dev/null || fail 'Local root authentication failed'

mkdir -p "$PARENT"
run_root="$(mktemp -d "$PARENT/run.XXXXXXXX")"
suffix="$(basename "$run_root" | cut -d. -f2 | tr '[:upper:]' '[:lower:]')"
[[ "$suffix" =~ ^[a-z0-9]{8}$ ]] || fail 'Unexpected isolated folder suffix'
database="cb_crm_it_$suffix"
db_user="cb_it_$suffix"
db_password="$(php -r 'echo bin2hex(random_bytes(24));')"
wp_root="$run_root/wordpress"
crm_sha="$(git -C "$ROOT" rev-parse HEAD)"
base_sha="$(git -C "$BASE_SOURCE" rev-parse HEAD)"
mkdir -p "$wp_root"

echo "ISOLATED_ROOT=$run_root"
echo "ISOLATED_DB=$database"
echo "CRM_SHA=$crm_sha"
echo "BASE_SHA=$base_sha"
echo 'Existing databases, installations, local repositories and dist/ are never overwritten.'

# Names are random, validated and non-reused. No DROP DATABASE/USER is used.
db_root --execute="
CREATE DATABASE $database CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
CREATE USER '$db_user'@'%' IDENTIFIED BY '$db_password';
GRANT ALL PRIVILEGES ON $database.* TO '$db_user'@'%';
" || fail 'Could not create isolated database and restricted test user'

# Download into an empty WordPress root first; stage plugins only after
# core is installed so WP-CLI's non-force safety check cannot be bypassed.
wp core download --path="$wp_root" --version="$WP_VERSION" --locale=en_US --skip-content --quiet
[[ "$(wp core version --path="$wp_root")" == "$WP_VERSION" ]] || fail 'Wrong WordPress version'
mkdir -p "$wp_root/wp-content/plugins/core-blueprint" "$wp_root/wp-content/plugins/core-blueprint-crm"
git -C "$BASE_SOURCE" archive --format=tar "$base_sha" \
  | tar -xf - -C "$wp_root/wp-content/plugins/core-blueprint"
git -C "$ROOT" archive --format=tar "$crm_sha" \
  | tar -xf - -C "$wp_root/wp-content/plugins/core-blueprint-crm"
wp config create --path="$wp_root" --dbname="$database" --dbuser="$db_user" \
  --dbpass="$db_password" --dbhost="127.0.0.1:3307" --dbprefix="cbt_" --skip-check --quiet
wp config set DISABLE_WP_CRON true --raw --path="$wp_root" --quiet
wp config set CB_CRM_INTEGRATION_DISPOSABLE true --raw --path="$wp_root" --quiet

admin_password="$(php -r 'echo bin2hex(random_bytes(24));')"
wp core install --path="$wp_root" --url="http://crm-sales-test.invalid" \
  --title="CRM Sales Integration Test" --admin_user="crm-it-admin" \
  --admin_password="$admin_password" --admin_email="crm-test@example.invalid" \
  --skip-email --quiet

wp plugin activate core-blueprint --path="$wp_root" --quiet
wp plugin activate core-blueprint-crm --path="$wp_root" --quiet

# Base's Privileged Access Guard intentionally restricts a newly created
# administrator pending signed approval, even when CRM grants role capabilities.
# Use the official, audited recovery command ONLY in this freshly provisioned
# disposable WordPress installation; never weaken the Base guard.
echo '==> Approve isolated test identity through canonical Base trust recovery'
wp cb operator recover crm-it-admin --path="$wp_root"
wp cb operator status crm-it-admin --path="$wp_root"

echo '==> Running actual WordPress and InnoDB tests'
# WP-CLI eval-file passes file contents through eval(), where a strict_types
# declaration can no longer be the first statement. Require the real file
# through wp eval instead; PHP then parses it as an independent source file.
CB_CRM_INTEGRATION_TEST_FILE="$ROOT/tests/integration/sales-mariadb.php" \
  wp eval 'require getenv("CB_CRM_INTEGRATION_TEST_FILE");' --path="$wp_root"
CB_CRM_INTEGRATION_TEST_FILE="$ROOT/tests/integration/sales-transitions.php" \
  wp eval 'require getenv("CB_CRM_INTEGRATION_TEST_FILE");' --path="$wp_root"

echo '==> Verify B2 replay-safe conversion and real InnoDB rollback'
CB_CRM_INTEGRATION_TEST_FILE="$ROOT/tests/integration/sales-conversion.php" \
  wp eval 'require getenv("CB_CRM_INTEGRATION_TEST_FILE");' --path="$wp_root"

echo '==> Verify B2 concurrent conversion from two independent WordPress processes'
b2_fixture="$ROOT/tests/integration/sales-conversion-concurrent.php"
[[ -f "$b2_fixture" ]] || fail 'Concurrent conversion fixture missing'
b2_eval() {
  local worker=""
  if (( $# > 1 )); then worker="$2"; fi
  CB_CRM_B2_PHASE="$1" CB_CRM_B2_GATE_DIR="$run_root" CB_CRM_B2_WORKER="$worker" \
    CB_CRM_INTEGRATION_TEST_FILE="$b2_fixture" \
    timeout 70s wp eval 'require getenv("CB_CRM_INTEGRATION_TEST_FILE");' --path="$wp_root"
}
b2_eval prepare
b2_eval convert 1 >"$run_root/b2-convert-1.log" 2>&1 &
b2_pid1=$!
b2_eval convert 2 >"$run_root/b2-convert-2.log" 2>&1 &
b2_pid2=$!
b2_release_workers() {
  : >"$run_root/b2_go"
  wait "$b2_pid1" 2>/dev/null || true
  wait "$b2_pid2" 2>/dev/null || true
}
trap b2_release_workers EXIT
ticks=0
while [[ ! -f "$run_root/b2_ready_1" || ! -f "$run_root/b2_ready_2" ]]; do
  if ! kill -0 "$b2_pid1" 2>/dev/null || ! kill -0 "$b2_pid2" 2>/dev/null; then
    cat "$run_root/b2-convert-1.log" "$run_root/b2-convert-2.log"
    fail 'Concurrent conversion worker exited before barrier'
  fi
  if (( ticks >= 200 )); then
    cat "$run_root/b2-convert-1.log" "$run_root/b2-convert-2.log"
    fail 'Concurrent conversion workers did not both reach barrier in 20 seconds'
  fi
  sleep 0.1
  ticks=$(( ticks + 1 ))
done
: >"$run_root/b2_go"
if ! wait "$b2_pid1"; then
  cat "$run_root/b2-convert-1.log" "$run_root/b2-convert-2.log"
  fail 'First concurrent conversion failed'
fi
if ! wait "$b2_pid2"; then
  cat "$run_root/b2-convert-1.log" "$run_root/b2-convert-2.log"
  fail 'Second concurrent conversion failed'
fi
trap - EXIT
cat "$run_root/b2-convert-1.log" "$run_root/b2-convert-2.log"
b2_id1="$(sed -n 's/^CONVERTED_ID=\([0-9][0-9]*\)$/\1/p' "$run_root/b2-convert-1.log")"
b2_id2="$(sed -n 's/^CONVERTED_ID=\([0-9][0-9]*\)$/\1/p' "$run_root/b2-convert-2.log")"
[[ -n "$b2_id1" && "$b2_id1" == "$b2_id2" ]] \
  || fail 'Concurrent callers did not receive the same durable Opportunity ID'
b2_eval verify
echo '==> Verify B3 Won/Lost/Reopen and InnoDB outcome-event rollback'
CB_CRM_INTEGRATION_TEST_FILE="$ROOT/tests/integration/sales-outcomes.php" \
  wp eval 'require getenv("CB_CRM_INTEGRATION_TEST_FILE");' --path="$wp_root"
echo 'CRM Sales real WordPress/MariaDB integration: PASS'

# Optional real single-site WordPress deleted_user SQL-failure/recovery fixture.
# Its test login and MariaDB trigger exist only in this new disposable site.
if [[ "${CB_CRM_TEST_USER_RECOVERY:-0}" == "1" ]]; then
  echo '==> Test durable single-site user anonymization recovery under SQL failure'
  CB_CRM_INTEGRATION_TEST_FILE="$ROOT/tests/integration/sales-user-anonymization.php" \
    wp eval 'require getenv("CB_CRM_INTEGRATION_TEST_FILE");' --path="$wp_root"
fi

# Optional real WP-CLI inventory and explicitly approved one-ID retry.
# All fixtures and all writes remain confined to this newly generated DB.
if [[ "${CB_CRM_TEST_OVERSIGHT:-0}" == "1" ]]; then
  echo '==> Test approved CRM recovery CLI, keyset pagination and one-ID replay'
  fixture="$ROOT/tests/integration/recovery-oversight.php"
  [[ -f "$fixture" ]] || fail 'Recovery oversight fixture missing'
  CB_CRM_OVERSIGHT_PHASE=seed CB_CRM_INTEGRATION_TEST_FILE="$fixture" \
    wp eval 'require getenv("CB_CRM_INTEGRATION_TEST_FILE");' --path="$wp_root"
  if wp cb-crm-recovery status --path="$wp_root" >"$run_root/recovery-unapproved.log" 2>&1; then
    fail 'Unauthenticated operator unexpectedly accessed the recovery inventory'
  fi
  first_page="$(wp --user=crm-it-admin cb-crm-recovery status --after=0 --limit=20 --path="$wp_root")"
  echo "$first_page"
  [[ "$first_page" == *"HAS_MORE=yes"* ]] || fail 'Recovery inventory lost continuation before 20 intents'
  cursor="$(printf '%s\n' "$first_page" | sed -n 's/^NEXT_CURSOR=//p')"
  [[ "$cursor" =~ ^[0-9]+$ ]] || fail 'Recovery inventory emitted invalid keyset cursor'
  last_page="$(wp --user=crm-it-admin cb-crm-recovery status --after="$cursor" --limit=20 --path="$wp_root")"
  echo "$last_page"
  [[ "$last_page" == *"HAS_MORE=no"* ]] || fail 'Recovery inventory failed to reach final intents'
  [[ "$last_page" == *"invalid"* ]] || fail 'Malformed recovery intent was silently hidden'
  if wp --user=crm-it-admin cb-crm-recovery retry --kind=user --id=700000024 --path="$wp_root" >"$run_root/recovery-unconfirmed.log" 2>&1; then
    fail 'Recovery retry unexpectedly succeeded without explicit confirmation'
  fi
  wp --user=crm-it-admin cb-crm-recovery retry --kind=user --id=700000024 --confirm=1 --path="$wp_root"
  CB_CRM_OVERSIGHT_PHASE=verify CB_CRM_INTEGRATION_TEST_FILE="$fixture" \
    wp eval 'require getenv("CB_CRM_INTEGRATION_TEST_FILE");' --path="$wp_root"
fi

# Optional real WordPress wp_options/cron fair scheduling for both queues.
# No existing database is touched and no Sales rows are mutated.
if [[ "${CB_CRM_TEST_QUEUE_FAIRNESS:-0}" == "1" ]]; then
  echo '==> Test fair scheduled recovery across more than twenty pending intents'
  fixture="$ROOT/tests/integration/recovery-queue-fairness.php"
  [[ -f "$fixture" ]] || fail 'Recovery fairness integration fixture missing'
  CB_CRM_FAIRNESS_PHASE=seed CB_CRM_INTEGRATION_TEST_FILE="$fixture" \
    wp eval 'require getenv("CB_CRM_INTEGRATION_TEST_FILE");' --path="$wp_root"
  CB_CRM_FAIRNESS_PHASE=verify CB_CRM_INTEGRATION_TEST_FILE="$fixture" \
    wp eval 'require getenv("CB_CRM_INTEGRATION_TEST_FILE");' --path="$wp_root"
fi

# Optional two-process race, separated from ordinary fresh-install acceptance.
# Only paths/files inside this newly created randomly named test directory.
if [[ "${CB_CRM_TEST_CONCURRENT:-0}" == "1" ]]; then
  echo '==> Test real concurrent deletion before Sales identity lock'
  fixture="$ROOT/tests/integration/sales-concurrent-deletion.php"
  [[ -f "$fixture" ]] || fail 'Concurrent deletion PHP fixture missing'
  race_eval() {
    CB_CRM_RACE_PHASE="$1" CB_CRM_RACE_GATE_DIR="$run_root" CB_CRM_INTEGRATION_TEST_FILE="$fixture" \
      wp eval 'require getenv("CB_CRM_INTEGRATION_TEST_FILE");' --path="$wp_root"
  }
  race_eval prepare

  # Child creates a Sales record but pauses BEFORE its locking read from
  # wp_posts. The parent removes the identity from another PHP/WP process.
  CB_CRM_RACE_PHASE=create CB_CRM_RACE_GATE_DIR="$run_root" CB_CRM_INTEGRATION_TEST_FILE="$fixture" \
    wp eval 'require getenv("CB_CRM_INTEGRATION_TEST_FILE");' --path="$wp_root" \
      >"$run_root/race-create.log" 2>&1 &
  race_pid="$!"
  release_stalled_child() {
    : >"$run_root/race_go"
    if [[ -n "${race_pid:-}" ]]; then wait "$race_pid" || true; fi
  }
  trap release_stalled_child EXIT
  ticks=0
  while [[ ! -f "$run_root/race_identity_before_lock" ]]; do
    if ! kill -0 "$race_pid" 2>/dev/null; then
      cat "$run_root/race-create.log"
      fail 'Sales child exited before canonical locking read'
    fi
    if (( ticks >= 200 )); then
      cat "$run_root/race-create.log"
      fail 'Sales child did not reach canonical locking read in 20 seconds'
    fi
    sleep 0.1
    ticks=$(( ticks + 1 ))
  done
  race_eval delete
  : >"$run_root/race_go"
  if ! wait "$race_pid"; then
    cat "$run_root/race-create.log"
    fail 'Sales child did not reject a deleted identity'
  fi
  race_pid=""
  trap - EXIT
  cat "$run_root/race-create.log"
  race_eval verify
fi
# Optional inverse ordering, using a separate identity from deletion-first.
# Process A holds a canonical wp_posts FOR UPDATE lock. Process B starts
# wp_delete_post but must not complete until A commits Lead + participant.
if [[ "${CB_CRM_TEST_CREATION_FIRST:-0}" == "1" ]]; then
  echo '==> Test real creation-first row locking and subsequent WordPress deletion'
  fixture="$ROOT/tests/integration/sales-concurrent-creation-first.php"
  [[ -f "$fixture" ]] || fail 'Creation-first concurrency PHP fixture missing'
  race2_eval() {
    CB_CRM_RACE_PHASE="$1" CB_CRM_RACE_GATE_DIR="$run_root" CB_CRM_INTEGRATION_TEST_FILE="$fixture" \
      timeout 50s wp eval 'require getenv("CB_CRM_INTEGRATION_TEST_FILE");' --path="$wp_root"
  }
  race2_eval prepare

  race2_eval create >"$run_root/creation-first-create.log" 2>&1 &
  creator_pid=$!
  deleter_pid=""
  release_creator_and_children() {
    : >"$run_root/creation_first_go"
    if [[ -n "${creator_pid:-}" ]]; then wait "$creator_pid" || true; fi
    if [[ -n "${deleter_pid:-}" ]]; then wait "$deleter_pid" || true; fi
  }
  trap release_creator_and_children EXIT

  ticks=0
  while [[ ! -f "$run_root/creation_first_identity_locked" ]]; do
    if ! kill -0 "$creator_pid" 2>/dev/null; then
      cat "$run_root/creation-first-create.log"
      fail 'Creator exited before completing canonical identity lock'
    fi
    if (( ticks >= 200 )); then
      cat "$run_root/creation-first-create.log"
      fail 'Creator did not reach locked pre-insert pause in 20 seconds'
    fi
    sleep 0.1
    ticks=$(( ticks + 1 ))
  done

  race2_eval delete >"$run_root/creation-first-delete.log" 2>&1 &
  deleter_pid=$!
  ticks=0
  while [[ ! -f "$run_root/creation_first_delete_entered" ]]; do
    if ! kill -0 "$deleter_pid" 2>/dev/null; then
      cat "$run_root/creation-first-delete.log"
      fail 'Deleter exited before entering WordPress deletion hooks'
    fi
    if (( ticks >= 200 )); then
      cat "$run_root/creation-first-delete.log"
      fail 'Deleter did not enter deletion hook in 20 seconds'
    fi
    sleep 0.1
    ticks=$(( ticks + 1 ))
  done

  # Deleter must remain pending while the creator holds the post row lock.
  sleep 1
  if ! kill -0 "$deleter_pid" 2>/dev/null; then
    cat "$run_root/creation-first-delete.log"
    fail 'WordPress deletion finished before Sales released its post lock'
  fi
  echo 'PASS: deleting WordPress request waits for committed Sales identity lock'
  : >"$run_root/creation_first_go"

  if ! wait "$creator_pid"; then
    cat "$run_root/creation-first-create.log"
    fail 'Sales creator failed after releasing its post row lock'
  fi
  creator_pid=""
  if ! wait "$deleter_pid"; then
    cat "$run_root/creation-first-delete.log"
    fail 'WordPress deletion did not complete after Sales commit'
  fi
  deleter_pid=""
  trap - EXIT
  cat "$run_root/creation-first-create.log"
  cat "$run_root/creation-first-delete.log"
  race2_eval verify
fi
echo "Artifacts and isolated database retained for inspection: $run_root | $database"
